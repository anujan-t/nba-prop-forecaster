# COURTSIDE Coach: optional language model.
# Copy this file to .env (git-ignored) and fill in ONE option. Start.ps1 loads .env automatically.
# Without a model the built-in coach still answers slip commands, props, parlays, news, injuries, games and lines,
# teams, coaches, standings, betting math and questions about the app; a model adds free-form conversation.
# A model on another computer only receives your question, public NBA data and the app's computed numbers: questions
# about your slip, bets and record are answered on this computer, and your chat history is never sent.

# Option A: Google Gemini (free tier available at https://aistudio.google.com/apikey). Prefer setting GEMINI_API_KEY as
# a Windows user environment variable instead of writing it here; Start.ps1 reads it from there too.
# Note: Google may use free-tier prompts to improve its products.
# GEMINI_API_KEY=<your key>
# COURTSIDE_GEMINI_MODEL=gemini-3.8-flash

# Option B: OpenAI
# COURTSIDE_LLM_MODEL=gpt-4o-mini
# COURTSIDE_LLM_API_KEY=sk-...

# Option C: a free local model with Ollama (https://ollama.com), e.g. `ollama pull llama3.1` then:
# COURTSIDE_LLM_MODEL=llama3.1
# COURTSIDE_LLM_BASE_URL=http://127.0.0.1:11434/v1

# Option D: Anthropic (OpenAI-compatible endpoint)
# COURTSIDE_LLM_MODEL=<a model id from Anthropic's model list>
# COURTSIDE_LLM_BASE_URL=https://api.anthropic.com/v1
# COURTSIDE_LLM_API_KEY=sk-ant-...

# Option E: OpenRouter (one key, many models; https://openrouter.ai/models)
# COURTSIDE_LLM_MODEL=openai/gpt-4o-mini
# COURTSIDE_LLM_BASE_URL=https://openrouter.ai/api/v1
# COURTSIDE_LLM_API_KEY=sk-or-...

# Option F: Azure OpenAI (v1 endpoint) or any other OpenAI-compatible server
# COURTSIDE_LLM_MODEL=<deployment-name>
# COURTSIDE_LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1
# COURTSIDE_LLM_API_KEY=<key>
# COURTSIDE_LLM_KEY_HEADER=api-key

# Optional tuning for any model: requests per minute (paces calls under a free-tier limit), reasoning effort for
# thinking models (minimal, low, medium, high), and USD prices per million input / output tokens for cost estimates.
# COURTSIDE_LLM_RPM=10
# COURTSIDE_LLM_REASONING_EFFORT=low
# COURTSIDE_LLM_PRICE_IN=0.50
# COURTSIDE_LLM_PRICE_OUT=3.00

# Set to 0 to disable background calibration retraining.
# COURTSIDE_BACKGROUND=1
