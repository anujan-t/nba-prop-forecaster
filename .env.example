# COURTSIDE Coach: optional language model.
# Copy this file to .env (git-ignored) and fill in ONE option. Start.ps1 loads .env automatically.
# Without a model the built-in coach still answers slip commands, props, parlays, news, injuries, games and lines,
# teams, coaches, standings, betting math and questions about the app; a model adds free-form conversation.

# Option A: OpenAI
# COURTSIDE_LLM_MODEL=gpt-4o-mini
# COURTSIDE_LLM_API_KEY=sk-...

# Option B: a free local model with Ollama (https://ollama.com), e.g. `ollama pull llama3.1` then:
# COURTSIDE_LLM_MODEL=llama3.1
# COURTSIDE_LLM_BASE_URL=http://127.0.0.1:11434/v1

# Option C: Anthropic (OpenAI-compatible endpoint)
# COURTSIDE_LLM_MODEL=<a model id from Anthropic's model list>
# COURTSIDE_LLM_BASE_URL=https://api.anthropic.com/v1
# COURTSIDE_LLM_API_KEY=sk-ant-...

# Option D: OpenRouter (one key, many models; https://openrouter.ai/models)
# COURTSIDE_LLM_MODEL=openai/gpt-4o-mini
# COURTSIDE_LLM_BASE_URL=https://openrouter.ai/api/v1
# COURTSIDE_LLM_API_KEY=sk-or-...

# Option E: Azure OpenAI (v1 endpoint) or any other OpenAI-compatible server
# COURTSIDE_LLM_MODEL=<deployment-name>
# COURTSIDE_LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1
# COURTSIDE_LLM_API_KEY=<key>
# COURTSIDE_LLM_KEY_HEADER=api-key

# Set to 0 to disable background calibration retraining.
# COURTSIDE_BACKGROUND=1
